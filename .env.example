# ────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instagram_dashboard?schema=public"

# ────────────────────────────────────────────────────────────────────
# Auth (NextAuth)
# ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# ────────────────────────────────────────────────────────────────────
# Meta / Instagram Graph API
# https://developers.facebook.com/docs/instagram-api/
# Required: a Facebook App with Instagram Graph API + a Page-linked
# IG Business/Creator account.
# ────────────────────────────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v21.0"
# Long-lived Page access token that has access to the IG Business account.
IG_ACCESS_TOKEN=""
# The IG Business Account ID (NOT the username, NOT the FB Page ID).
IG_BUSINESS_ACCOUNT_ID=""
# Webhook verification token (you set this in Meta App > Webhooks)
IG_WEBHOOK_VERIFY_TOKEN="change-me"

# ────────────────────────────────────────────────────────────────────
# ManyChat (optional – used for DM automation + lead attribution)
# https://api.manychat.com/swagger
# ────────────────────────────────────────────────────────────────────
MANYCHAT_API_KEY=""

# ────────────────────────────────────────────────────────────────────
# Cron secret (protects /api/cron/* routes from unauthorized callers)
# ────────────────────────────────────────────────────────────────────
CRON_SECRET="change-me"

# ────────────────────────────────────────────────────────────────────
# Optional: Google Analytics 4 (Measurement Protocol) for landing
# page → lead attribution
# ────────────────────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
